/* 舞团页（TDesign 版） */
.gs-page { min-height: 100vh; background: #FFF5F5; }
.filter-bar {
  display: flex; white-space: nowrap;
  padding: 12px 16px; background: #FFFFFF;
  border-bottom: 1px solid #F5F0F0;
}
.filter-tag {
  display: inline-block; padding: 5px 14px; margin-right: 10px;
  border-radius: 16px; font-size: 12px; color: #666;
  background: #F5F0F0; flex-shrink: 0;
}
.filter-tag.active { color: #C41E2A; background: #FFF5F5; font-weight: 600; border: 1px solid #C41E2A; }
.tag-count { font-size: 10px; opacity: 0.6; }
.list-wrap { padding: 8px 12px; }
.cell-rank {
  width: 22px; height: 22px; border-radius: 50%;
  background: linear-gradient(135deg, #C41E2A, #A01822);
  color: #fff; font-size: 10px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 12px; flex-shrink: 0;
}
.cell-name { font-size: 14px; font-weight: 600; color: #2C2C2C; }
